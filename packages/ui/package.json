{
  "name": "@gestionale/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design system condiviso del core (ADR-0027 §D5 passo 2): componenti shadcn agnostici + utility cn. Consumato da Next via transpilePackages (source export, \"use client\" preservato).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/tokens.css": "./src/tokens.css",
    "./tailwind-preset": {
      "types": "./tailwind-preset.ts",
      "default": "./tailwind-preset.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "tailwind-preset.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7",
    "clsx": "^2.1",
    "lucide-react": "^0.460",
    "react-hook-form": "^7.75.0",
    "tailwind-merge": "^2.5"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
