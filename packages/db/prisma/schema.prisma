// =============================================================================
// schema.prisma — Gestionale data layer (multi-tenant)
// =============================================================================
// Convenzioni (vedi PROJECT_BRIEF.md §C1):
// - id: UUID v7 generato app-side (libreria `uuidv7`) -> niente @default qui,
//   l'omissione su create() e' errore esplicito (coerenza con la regola).
// - tenant_id: presente su ogni tabella multi-tenant; FK -> tenants(id) CASCADE.
// - sede_id: presente su tabelle operative; FK -> sedi(id) CASCADE / SET NULL.
// - timestamps: created_at, updated_at (auto via Prisma); deleted_at? per soft
//   delete (extension client-side aggiunta nel prossimo macro-task).
// - snake_case in DB via @map / @@map; camelCase in TS.
// - RLS PostgreSQL attivato in migration separata (enable_rls), policy
//   placeholder USING (true) finche' arrivera' auth NestJS con SET app.tenant_id.
// - 2 UNIQUE INDEX parziali su user_roles per gestire NULL su sede_id sono
//   aggiunti via SQL raw nella migration init (Prisma non li esprime).
//
// Vedi ADR-0005 per il razionale completo.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // url (runtime queries): app role `gestionale_app` (NOSUPERUSER, NOBYPASSRLS).
  // RLS enforcement passes attraverso questa connection.
  url       = env("DATABASE_URL")
  // directUrl (DDL: migrate, db push, introspect): superuser `postgres`.
  // Prisma 5+ usa directUrl per migrazioni quando definita. Vedi ADR-0009 D3b.
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// Multi-tenant root entities
// =============================================================================

model Tenant {
  id       String  @id
  name     String
  slug     String  @unique
  isActive Boolean @default(true) @map("is_active")

  // Identità pubblica dello studio (ADR-0049). Mostrata sulla landing pubblica
  // /t/<slug> via GET /public/tenants/:slug (@Public, nessun campo segreto).
  // Tutti nullable: popolati in onboarding/seed, assenza = sezione omessa nella UI.
  descrizione   String?
  indirizzo     String?
  telefono      String?
  emailContatto String? @map("email_contatto")
  sitoWeb       String? @map("sito_web")
  logoUrl       String? @map("logo_url")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  sedi                 Sede[]
  users                User[]
  roles                Role[]
  auditLogs            AuditLog[]
  menus                Menu[]
  menuCategories       MenuCategory[]
  articles             Article[]
  priceLists           PriceList[]
  articlePrices        ArticlePrice[]
  recipes              Recipe[]
  pricingRules         PricingRule[]
  tavoli               Tavolo[]
  aziende              Azienda[]
  referenti            Referente[]
  preventivi           Preventivo[]
  preventiviVoci       PreventivoVoce[]
  scadenze             Scadenza[]
  scadenzeCategorie    ScadenzaCategoria[]
  comunicazioni        Comunicazione[]
  comMessaggi          ComMessaggio[]
  comAllegati          ComAllegato[]
  comCounter           ComCounter?
  documentiTipi        DocumentoTipo[]
  documenti            Documento[]
  circolari            Circolare[]
  circolariDestinatari CircolareDestinatario[]
  circolariLetture     CircolareLettura[]
  passwordResets       PasswordReset[]
  clienteInviti        ClienteInvito[]
  mandati              Mandato[]
  rdlCounters          RdlCounter[]
  prestazioni          Prestazione[]
  tariffeOrarie        TariffaOraria[]
  conti                Conto[]
  contiRighe           ContoRiga[]
  comandas             Comanda[]

  @@map("tenants")
}

model Sede {
  id         String    @id
  tenantId   String    @map("tenant_id")
  name       String
  address    String?
  city       String?
  postalCode String?   @map("postal_code")
  country    String    @default("IT")
  timezone   String    @default("Europe/Rome")
  currency   String    @default("EUR")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  // Relations
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]
  sessions  Session[]
  auditLogs AuditLog[]

  @@index([tenantId])
  @@map("sedi")
}

// =============================================================================
// Identity: User (vive a livello tenant; ruoli per-sede via UserRole.sedeId)
// =============================================================================

// [livello 2 — portale cliente, ADR-0046] Discriminatore single-table:
// operatore = utente interno studio (default → backfill implicito sugli esistenti);
// cliente   = utente del portale, sempre legato a una azienda (vedi CHECK
//             chk_cliente_azienda_id nella migration add_portale_cliente_identity).
enum UserTipo {
  operatore
  cliente

  @@map("user_tipo")
}

// Ruolo del cliente DENTRO la propria azienda (legacy `users.cliente_ruolo`).
// admin = gestisce anagrafica/referenti/inviti della propria azienda (task
// successivi); utente = standard. Nullo per gli operatori.
enum ClienteRuolo {
  admin
  utente

  @@map("cliente_ruolo")
}

model User {
  id                  String    @id
  tenantId            String    @map("tenant_id")
  email               String
  passwordHash        String    @map("password_hash")
  pinHash             String?   @map("pin_hash") // login PIN per POS, hashed argon2
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  emailVerifiedAt     DateTime? @map("email_verified_at")
  lastLoginAt         DateTime? @map("last_login_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  isActive            Boolean   @default(true) @map("is_active")

  // [livello 2 — portale cliente, ADR-0046] identità operatore vs cliente.
  // Invariante DB: tipo='cliente' ⟺ aziendaId NOT NULL (CHECK chk_cliente_azienda_id).
  tipo         UserTipo      @default(operatore)
  aziendaId    String?       @map("azienda_id")
  clienteRuolo ClienteRuolo? @map("cliente_ruolo")

  // [PRE F2] — campi predisposti, non attivati in F1
  totpSecret String?   @map("totp_secret") // 2FA TOTP
  validUntil DateTime? @map("valid_until") // scadenza account stagionali
  badgeNfcId String?   @map("badge_nfc_id") // badge NFC/QR (lettore non in F1)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles         UserRole[] @relation("UserRoleAssignment")
  assignedRoles UserRole[] @relation("UserRoleAssignedBy")
  sessions      Session[]
  auditLogs     AuditLog[]
  // [livello 2 — portale cliente, ADR-0046] azienda di appartenenza (solo
  // tipo=cliente). CASCADE: eliminare l'azienda elimina i suoi utenti-portale
  // (divergenza dal legacy SET NULL, incompatibile con il CHECK §2 ADR-0046).
  azienda       Azienda?   @relation("AziendaUtentiPortale", fields: [aziendaId], references: [id], onDelete: Cascade)

  // Comunicazioni: operatore assegnato a un thread + autore di un messaggio.
  comunicazioniAssegnate Comunicazione[]    @relation("ComOperatore")
  comMessaggiAutore      ComMessaggio[]     @relation("ComAutore")
  // Documenti caricati dall'operatore.
  documentiCreati        Documento[]        @relation("DocumentoCreatore")
  // [livello 2 — portale cliente, ADR-0048] letture/conferme circolari (cliente).
  circolariLetture       CircolareLettura[]
  // Reset password: token monouso a tempo (forgot/reset flow).
  passwordResets         PasswordReset[]
  // Inviti cliente creati da questo operatore (invitatoDa).
  clienteInvitiCreati    ClienteInvito[]    @relation("ClienteInvitoInvitatoDa")
  // Prestazioni/timesheet svolte da questo utente (ADR-0053).
  prestazioni            Prestazione[]
  // Tariffario orario per-utente (ADR-0055): override del costo orario di ruolo.
  tariffeOrarie          TariffaOraria[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([aziendaId])
  @@map("users")
}

// =============================================================================
// RBAC: permission catalog (globale) + system templates (globale)
//       + roles (tenant-scoped) + join tables
// =============================================================================

// Catalogo permessi atomici. Globale (no tenant_id), immutabile (no soft-delete).
// Seedabile da prisma/seed.ts (macro-task successivo).
model Permission {
  id          String  @id
  code        String  @unique // es. "comande.crea", "report.fatturato.visualizza"
  description String
  category    String // es. "comande", "report", "anagrafica", "sistema"
  isPreF2     Boolean @default(false) @map("is_pre_f2") // true per feature [PRE F2] non attive in F1

  // Relations
  rolePermissions               RolePermission[]
  systemRoleTemplatePermissions SystemRoleTemplatePermission[]

  @@index([category])
  @@map("permissions")
}

// Template ruoli di sistema (globali). Quando nasce un tenant, il bootstrap
// clona questi template in `roles` con il relativo tenant_id (vedi ADR-0005).
// Niente tenant_id (sono template). Niente soft-delete (gestiti come immutabili).
model SystemRoleTemplate {
  id          String   @id
  name        String   @unique // es. "Super Admin", "Cameriere"
  description String
  isDefault   Boolean  @default(false) @map("is_default") // true = clonato automaticamente al bootstrap tenant
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  permissions SystemRoleTemplatePermission[]

  @@map("system_role_templates")
}

// Join table M:N system template <-> permission.
model SystemRoleTemplatePermission {
  templateId   String @map("template_id")
  permissionId String @map("permission_id")

  // Relations
  template   SystemRoleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  permission Permission         @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([templateId, permissionId])
  @@map("system_role_template_permissions")
}

// Ruoli effettivi tenant-scoped. is_system=true per ruoli clonati dai template
// (non eliminabili lato app, vincolo enforced in NestJS service layer).
model Role {
  id          String    @id
  tenantId    String    @map("tenant_id")
  name        String
  description String
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  userRoles     UserRole[]
  // Tariffario orario per-ruolo (ADR-0055): costo orario default del ruolo.
  tariffeOrarie TariffaOraria[]

  // Unicità nome soft-delete-aware (TD-BZ, ADR-0023): partial unique index
  // `(tenant_id, name) WHERE deleted_at IS NULL` (vedi migration td_bz_partial_
  // unique_role). Prisma 6 non esprime i partial index nel DSL → no @@unique.
  @@index([tenantId])
  @@map("roles")
}

// Join table M:N role <-> permission.
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Assegnamento user <-> role, opzionalmente scoped per sede.
// - sedeId NULL  -> ruolo tenant-wide (es. Super Admin)
// - sedeId !NULL -> ruolo per-sede (es. Cameriere in Sede A)
// 2 UNIQUE INDEX parziali in migration init garantiscono unicita' in entrambi
// i casi (PostgreSQL considera NULL != NULL negli UNIQUE standard).
model UserRole {
  id           String   @id
  userId       String   @map("user_id")
  roleId       String   @map("role_id")
  sedeId       String?  @map("sede_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedById String?  @map("assigned_by_id")

  // Relations
  user       User  @relation("UserRoleAssignment", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  sede       Sede? @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([roleId])
  @@index([sedeId])
  @@map("user_roles")
}

// =============================================================================
// Sessions (separate per dispositivo, vedi §B1)
// =============================================================================

enum DeviceType {
  web
  pos_tablet
  pos_desktop
  mobile

  @@map("device_type")
}

model Session {
  id               String     @id
  userId           String     @map("user_id")
  sedeId           String?    @map("sede_id")
  deviceId         String     @map("device_id")
  deviceType       DeviceType @map("device_type")
  refreshTokenHash String     @map("refresh_token_hash") // argon2
  ip               String?
  userAgent        String?    @map("user_agent")
  lastSeenAt       DateTime   @default(now()) @map("last_seen_at")
  expiresAt        DateTime   @map("expires_at")
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  // Relations
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sede Sede? @relation(fields: [sedeId], references: [id], onDelete: SetNull)

  @@index([refreshTokenHash])
  @@index([userId, isActive])
  @@map("sessions")
}

// =============================================================================
// Password reset — token monouso a tempo (flow forgot/reset, ADR-0008)
// =============================================================================
// Tenant-scoped (RLS flat, tenant_id denormalizzato → policy identica a
// circolari_letture). Sicurezza:
//   - In DB salviamo SOLO l'hash sha256 del token (token_hash), mai il
//     plaintext: l'email contiene il token in chiaro, il DB no (parità con
//     refresh_token_hash su sessions).
//   - expires_at: TTL breve (1h, vedi AuthService). usedAt: monouso —
//     valorizzato al consumo, blocca i replay.
model PasswordReset {
  id        String    @id
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash") // sha256 hex del token (no plaintext)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([tokenHash])
  @@map("password_resets")
}

// =============================================================================
// Invito cliente — onboarding utente-portale (token email, ADR-0046 / legacy
// StudioDesk `inviti`)
// =============================================================================
// Tenant-scoped (RLS flat, tenant_id denormalizzato → policy identica a
// password_resets). Token sha256 (no plaintext, parità con PasswordReset),
// TTL 7gg, monouso (usedAt). Dedup naturale (tenant, azienda, email): un solo
// invito per coppia → creaInvito fa upsert (rinnova token+scadenza).
// Alla accettazione: crea User tipo=cliente con clienteRuolo dell'invito
// (auto-promote ad admin se l'azienda non ha ancora un admin attivo).
model ClienteInvito {
  id           String       @id
  tenantId     String       @map("tenant_id")
  aziendaId    String       @map("azienda_id")
  email        String
  clienteRuolo ClienteRuolo @default(utente) @map("cliente_ruolo")
  tokenHash    String       @map("token_hash") // sha256 hex del token (no plaintext)
  expiresAt    DateTime     @map("expires_at")
  usedAt       DateTime?    @map("used_at")
  invitatoDaId String       @map("invitato_da_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  azienda    Azienda @relation(fields: [aziendaId], references: [id], onDelete: Cascade)
  invitatoDa User    @relation("ClienteInvitoInvitatoDa", fields: [invitatoDaId], references: [id], onDelete: Restrict)

  @@unique([tenantId, aziendaId, email])
  @@index([tenantId])
  @@index([tokenHash])
  @@map("cliente_inviti")
}

// =============================================================================
// Audit log (immutabile, no updated_at/deleted_at — vedi §B1)
// =============================================================================

model AuditLog {
  id          String   @id
  tenantId    String   @map("tenant_id")
  sedeId      String?  @map("sede_id")
  userId      String?  @map("user_id") // nullable per system events
  deviceId    String?  @map("device_id")
  action      String // es. "user.login", "ordine.crea", "menu.prezzo.modifica"
  entityType  String?  @map("entity_type") // es. "User", "Ordine"
  entityId    String?  @map("entity_id")
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  ip          String?
  userAgent   String?  @map("user_agent")
  timestamp   DateTime @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sede   Sede?  @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, timestamp(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// =============================================================================
// ═══ CONFINE CORE / DOMINIO — F1 Menu domain (sessione 17, ADR-0019) ═══
// =============================================================================
// CONVENTION (ADR-0026 D1, ADR-0027 §D5 passo 8b-1): questo banner segna il
// confine tra CORE e DOMINIO nell'UNICO file schema. NO split multi-file —
// "il data layer si arricchisce, non si splitta" (ADR-0026 D1/D6).
//   • Sopra il confine: modelli/enum CORE (piattaforma: tenancy, auth, rbac,
//     audit, sessioni). NB: l'enum DeviceType resta CORE (usato da Session).
//   • Sotto il confine: modelli/enum DOMINIO (verticale ristorazione).
//   • Nuovi modelli/enum: core sopra, dominio sotto.
// -----------------------------------------------------------------------------
// 5 modelli business: Menu, MenuCategory, Article, PriceList, ArticlePrice
// 2 placeholder PRE F2 (Gate D29): Recipe, PricingRule
// 5 enum nuovi: Allergen, DietaryTag, PrintDepartment, ArticleAvailability, Channel
//
// Sub-DP risolti (vedi ADR-0019):
//   1. Listini -> tabella separata PriceList + ArticlePrice (M:N con price override)
//   2. Allergeni -> enum Allergen[] (14 valori UE Reg. 1169/2011)
//   3. Tag dietetici -> enum DietaryTag[] (4 valori)
//   4. Reparto stampa -> enum PrintDepartment (3 valori, F2 -> tabella se serve custom)
//   5. Recipe + PricingRule -> skeleton minimal (popolati F2)
//   6. Varianti/Modificatori -> DEFERRED S18+ (workflow Comande)
//
// Convention: snake_case plurale @@map, FK RESTRICT business, CASCADE su tenantId,
// soft-delete su entita' business (no su ArticlePrice join puro), Decimal(10,2)
// monetario, Decimal(10,4) CO2 (precision higher per kgCO2eq fine-grained).
// =============================================================================

enum Allergen {
  // Lista standard UE (Allegato II Reg. UE 1169/2011, 14 allergeni)
  cereali_glutine
  crostacei
  uova
  pesce
  arachidi
  soia
  latte
  frutta_guscio
  sedano
  senape
  semi_sesamo
  anidride_solforosa
  lupini
  molluschi

  @@map("allergen")
}

enum DietaryTag {
  vegano
  vegetariano
  gluten_free
  piccante

  @@map("dietary_tag")
}

enum PrintDepartment {
  cucina
  pizzeria
  bar

  @@map("print_department")
}

enum ArticleAvailability {
  in_carta
  esaurito
  sospeso

  @@map("article_availability")
}

// Portata/corso di servizio (raggruppamento, NON sequenziamento uscita — fuori
// scope, trigger board KDS live). L'ordine di dichiarazione = ordine di servizio
// (Postgres enum ordina per posizione, come PrintDepartment): nessun campo
// `ordine` esplicito. `bevanda` è una portata vera in coda; `nessuna` = default
// per il non-classificato (bevande non mappate, coperto futuro, righe storiche)
// → nessun backfill (colonna NOT NULL default, come `stornata`).
enum Portata {
  antipasto
  primo
  secondo
  contorno
  dolce
  bevanda
  nessuna

  @@map("portata")
}

enum Channel {
  cassa
  menu_online
  asporto
  delivery

  @@map("channel")
}

model Menu {
  id          String    @id
  tenantId    String    @map("tenant_id")
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories MenuCategory[]

  // Unicità nome soft-delete-aware (TD-BZ, ADR-0023): partial unique index
  // `(tenant_id, name) WHERE deleted_at IS NULL` (migration td_bz_partial_unique_
  // soft_delete) — Prisma 6 non esprime i partial index nel DSL → no @@unique.
  @@index([tenantId])
  @@map("menus")
}

model MenuCategory {
  id        String    @id
  tenantId  String    @map("tenant_id")
  menuId    String    @map("menu_id")
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menu     Menu      @relation(fields: [menuId], references: [id], onDelete: Restrict)
  articles Article[]

  // Unicità nome soft-delete-aware (TD-BZ, ADR-0023): partial unique index
  // `(tenant_id, menu_id, name) WHERE deleted_at IS NULL` (vedi migration).
  @@index([tenantId])
  @@index([menuId])
  @@map("menu_categories")
}

model Article {
  id                     String              @id
  tenantId               String              @map("tenant_id")
  categoryId             String              @map("category_id")
  name                   String
  descriptionShort       String              @map("description_short")
  descriptionLong        String?             @map("description_long")
  photoUrl               String?             @map("photo_url")
  basePrice              Decimal             @map("base_price") @db.Decimal(10, 2)
  vatPercent             Int                 @map("vat_percent") // 4, 10, 22 (validato in DTO)
  allergens              Allergen[]
  dietaryTags            DietaryTag[]        @map("dietary_tags")
  printDepartment        PrintDepartment     @map("print_department")
  preparationTimeMinutes Int?                @map("preparation_time_minutes")
  availability           ArticleAvailability @default(in_carta)
  // Portata/corso per il raggruppamento KDS (default `nessuna` → no backfill).
  portata                Portata             @default(nessuna)
  sortOrder              Int                 @default(0) @map("sort_order")
  channelVisibility      Channel[]           @map("channel_visibility")
  co2KgEq                Decimal?            @map("co2_kg_eq") @db.Decimal(10, 4) // [PRE F2 B14]
  pricingRuleId          String?             @map("pricing_rule_id") // [PRE F2 B10]
  recipeId               String?             @map("recipe_id") // [PRE F2 B5]
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  deletedAt              DateTime?           @map("deleted_at")

  // Relations
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    MenuCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recipe      Recipe?        @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  pricingRule PricingRule?   @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull)
  prices      ArticlePrice[]
  contiRighe  ContoRiga[]

  // Unicità nome soft-delete-aware (TD-BZ, ADR-0023): partial unique index
  // `(tenant_id, category_id, name) WHERE deleted_at IS NULL` (vedi migration).
  // Sostituisce il @@unique compound S17 (STOP 1.5 opzione A): stesso vincolo
  // business — no articoli omonimi nella stessa categoria, upsert seed idempotente
  // — ma consente il riuso del nome di un articolo soft-deleted.
  @@index([tenantId])
  @@index([categoryId])
  @@map("articles")
}

model PriceList {
  id            String    @id
  tenantId      String    @map("tenant_id")
  name          String
  channels      Channel[]
  validFromDate DateTime? @map("valid_from_date") @db.Date
  validToDate   DateTime? @map("valid_to_date") @db.Date
  priority      Int       @default(0) // R2: tie-break futuro multi-match
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prices ArticlePrice[]

  // Unicità nome soft-delete-aware (TD-BZ, ADR-0023): partial unique index
  // `(tenant_id, name) WHERE deleted_at IS NULL` (vedi migration).
  @@index([tenantId])
  @@map("price_lists")
}

model ArticlePrice {
  // Join puro Article <-> PriceList con price override. NO soft-delete: eredita
  // lifecycle dei parent (Restrict su FK previene orphan). R1: solo price, no vatPercent
  // (IVA e' proprieta' Article, non varia per listino — BRIEF L304).
  id          String   @id
  tenantId    String   @map("tenant_id")
  articleId   String   @map("article_id")
  priceListId String   @map("price_list_id")
  price       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Restrict)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Restrict)

  @@unique([articleId, priceListId])
  @@index([tenantId])
  @@index([articleId])
  @@index([priceListId])
  @@map("article_prices")
}

model Recipe {
  // [PRE F2 B5 Magazzino] Placeholder predisposto per Gate D29.
  // Campi business (ingredients BOM, food cost) -> macro-task Magazzino F2.
  id        String    @id
  tenantId  String    @map("tenant_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  articles Article[]

  @@index([tenantId])
  @@map("recipes")
}

model PricingRule {
  // [PRE F2 B10 Pricing rules] Placeholder predisposto per Gate D29.
  // Campi business (conditions, override) -> macro-task Pricing F2.
  id        String    @id
  tenantId  String    @map("tenant_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  articles Article[]

  @@index([tenantId])
  @@map("pricing_rules")
}

// =============================================================================
// F2 Tavoli / Mappa sala (ADR-0058)
// =============================================================================
// Primo dominio nuovo costruito sul core post-estrazione (valida il core su un
// secondo verticale). Solo `Tavolo` + coordinate posX/posY per la mappa sala
// drag-drop (unico pattern FE nuovo: persistenza coordinate). `Sala`/`Zona` e lo
// stato tavolo (libero/occupato/riservato) deferiti — TD-sala-forward /
// TD-tavolo-stato-forward: nessun consumer reale ora, lo stato ha senso solo con
// un ordine attivo (comande non esistono ancora). `deletedAt` copre "fuori
// servizio". Unicità `numero` per-tenant soft-delete-aware `(tenant_id, numero)
// WHERE deleted_at IS NULL` via partial unique index raw (Prisma 6 non lo esprime
// nel DSL → no @@unique). RLS FORCE + policy `tavoli_tenant_isolation` nella migration.
model Tavolo {
  id        String    @id
  tenantId  String    @map("tenant_id")
  numero    String // etichetta/numero tavolo (es. "12", "Terrazza 3")
  capienza  Int // coperti
  posX      Float     @default(0) @map("pos_x") // nuovo tavolo nasce all'origine, poi trascinabile
  posY      Float     @default(0) @map("pos_y")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conti  Conto[]

  @@index([tenantId])
  @@map("tavoli")
}

// =============================================================================
// Blocco COMANDE — aggregato Conto (PR-1, ADR-0067)
// =============================================================================
// Sequenza food: Comande → KDS → Cassa pre-fiscale → RT differito. Le comande
// sono il primo sotto-blocco; l'aggregato dati è `Conto` (testata) → `ContoRiga`
// (righe). Scope-lock (STOP 1):
//   - 2 livelli. La Comanda (livello KDS) è DIFFERITA: si aggancerà in modo
//     additivo con `comandaId` nullable sulla riga → PR-1 NON predispone campi.
//   - Conto tenant-scoped come Tavolo (NO FK Tavolo→Sede ora; `sedeId` futuro
//     sarà migration additiva nullable con trigger multi-sede).
//   - Snapshot pricing (DP-C): la riga CONGELA prezzo/nome/reparto al momento
//     dell'ordine — colonne indipendenti, nessuna derivazione live da Article.
//   - Coerenza `tavoloId`↔`channel` = enforcement applicativo → PR-2 (non qui).
//   - Audit food-pattern: createdAt/updatedAt/deletedAt (NO createdBy — i model
//     food esistenti Menu/Article/Tavolo non lo hanno; solo Documento accountant).
//   - RLS FORCE su ENTRAMBI i model (vincolo architetturale) + soft-delete.
// =============================================================================

enum StatoConto {
  aperto
  chiuso
  annullato

  @@map("stato_conto")
}

// Stato della Comanda (livello KDS, ADR-attivazione-layer-comanda). Forward-only:
// inviata → in_preparazione → pronta (ammesso lo skip inviata → pronta). Nessuno
// stato `servita` (fuori scope KDS-core).
enum StatoComanda {
  inviata
  in_preparazione
  pronta

  @@map("stato_comanda")
}

model Conto {
  id        String     @id
  tenantId  String     @map("tenant_id")
  tavoloId  String?    @map("tavolo_id") // nullable: asporto/delivery non hanno tavolo
  channel   Channel // riusa l'enum food esistente — binding canale↔pricing
  coperti   Int? // nullable: asporto non ha coperti
  stato     StatoConto @default(aperto)
  apertoIl  DateTime   @default(now()) @map("aperto_il")
  chiusoIl  DateTime?  @map("chiuso_il")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  // Relations
  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tavolo  Tavolo?     @relation(fields: [tavoloId], references: [id], onDelete: SetNull)
  righe   ContoRiga[]
  comande Comanda[]

  @@index([tenantId])
  @@index([tavoloId])
  // PR-2 (ADR-0068) DP-2 "un tavolo, un conto aperto": partial unique index
  // `(tenant_id, tavolo_id) WHERE stato='aperto' AND tavolo_id IS NOT NULL`.
  // Prisma 6 non esprime i partial index nel DSL → definito in raw SQL nella
  // migration 20260702090000_add_conto_tavolo_aperto_unique (pattern *_active_uq).
  @@map("conti")
}

model ContoRiga {
  id             String          @id
  tenantId       String          @map("tenant_id") // RLS FORCE anche sulla riga (vincolo)
  contoId        String          @map("conto_id")
  articleId      String          @map("article_id")
  nomeArticolo   String          @map("nome_articolo") // snapshot: robustezza storica
  prezzoUnitario Decimal         @map("prezzo_unitario") @db.Decimal(10, 2) // snapshot congelato (DP-C)
  // Prezzi LORDI (IVA inclusa, ADR-0070): il totale è Σ prezzo×qta, nessuna IVA
  // aggiunta. `vatPercent` è snapshot da Article.vatPercent per lo scorporo
  // differito alla cassa — congelato all'ordine, come nome/prezzo/reparto.
  vatPercent     Int             @map("vat_percent")
  quantita       Int
  reparto        PrintDepartment // snapshot da Article.printDepartment (prepara KDS)
  // Snapshot da Article.portata (congelato all'ordine, come reparto/vatPercent):
  // il raggruppamento per portata di un conto storico non cambia se l'articolo
  // cambia portata dopo. Default `nessuna` → nessun backfill sulle righe esistenti.
  portata        Portata         @default(nessuna)
  // KDS (ADR-attivazione-layer-comanda): riga "inviata" quando comandaId != null.
  // Una riga inviata è IMMUTABILE (no update/storno) → semantica "non ancora
  // inviate" di comande.modifica. `note` = annotazione cucina per-riga (AI/NL fuori scope).
  comandaId      String?         @map("comanda_id")
  note           String?
  // Storno di una riga INVIATA (ADR-storno): distinto da `deletedAt` (che = "mai
  // ordinato / rimosso da pending"). `stornata=true` = "è esistita, la cucina
  // l'ha vista, è stata revocata" → esclusa dal totale (computeTotale) ma resta
  // visibile marcata (getConto + feed KDS). La perdita post-preparazione è in
  // audit (`conto_riga.storno_inviata` con lo StatoComanda). Terminale (no toggle).
  stornata       Boolean         @default(false)
  stornataIl     DateTime?       @map("stornata_il")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")

  // Relations
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conto   Conto    @relation(fields: [contoId], references: [id], onDelete: Cascade)
  article Article  @relation(fields: [articleId], references: [id], onDelete: Restrict)
  // onDelete SetNull: le comande NON si hard-deletano (soft-delete). SetNull è la
  // valvola di sicurezza per il purge-tenant cascade (evita il deadlock RESTRICT
  // tra le due cascade path conto→righe e conto→comande). Vedi ADR.
  comanda Comanda? @relation(fields: [comandaId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([contoId])
  @@index([articleId])
  @@index([comandaId])
  @@map("conti_righe")
}

// =============================================================================
// Comanda — livello KDS (ADR-attivazione-layer-comanda, attiva il differito 0067)
// =============================================================================
// Aggregato "invio-in-cucina di un sottoinsieme di righe": l'invio splitta le
// righe pending del conto PER REPARTO → N comande (una per reparto presente).
// Stato forward-only (StatoComanda). Tenant-scoped, RLS FORCE identico a
// conti/conti_righe. Snapshot vive sulle righe (nomeArticolo/reparto/quantita/note);
// la Comanda porta reparto (== reparto delle sue righe) + stato + timestamp.
// =============================================================================
model Comanda {
  id               String          @id
  tenantId         String          @map("tenant_id") // RLS FORCE (vincolo)
  contoId          String          @map("conto_id")
  reparto          PrintDepartment // reparto di destinazione (== reparto delle righe)
  stato            StatoComanda    @default(inviata)
  inviataIl        DateTime        @default(now()) @map("inviata_il")
  inPreparazioneIl DateTime?       @map("in_preparazione_il")
  prontaIl         DateTime?       @map("pronta_il")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")

  // Relations
  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conto  Conto       @relation(fields: [contoId], references: [id], onDelete: Cascade)
  righe  ContoRiga[]

  @@index([tenantId])
  @@index([contoId])
  @@index([tenantId, stato, reparto]) // feed KDS: GET /comande?stato=&reparto=
  @@map("comande")
}

// =============================================================================
// Dominio commercialisti (verticale accountant) — prima slice STOP-c1
// =============================================================================
// Anagrafica clienti dello studio (origine StudioDesk `aziende`, DB-per-tenant
// MySQL → qui tenant-scoped RLS single-DB, STOP-c). MVP 15 campi: RFM
// (operatore_riferimento_id → users) e blocco arricchimento deferiti.
// Unicità naturale `codice` per-tenant via partial-unique-index soft-delete-aware
// `(tenant_id, codice) WHERE deleted_at IS NULL` (Pattern 42 — vedi migration,
// NO @@unique nello schema). `eliminato`+`eliminata_il` StudioDesk collassano in
// `deletedAt`; `attivo` resta campo distinto (cliente sospeso ≠ cancellato).

enum TipoCliente {
  azienda
  persona_fisica
}

enum RuoloReferente {
  legale_rappresentante
  amministrativo
  tecnico
  altro
}

model Azienda {
  id             String      @id
  tenantId       String      @map("tenant_id")
  codice         String      @db.VarChar(20)
  nome           String      @db.VarChar(200)
  tipoCliente    TipoCliente @default(azienda) @map("tipo_cliente")
  partitaIva     String?     @map("partita_iva") @db.VarChar(20)
  codiceFiscale  String?     @map("codice_fiscale") @db.VarChar(20)
  codiceAteco    String?     @map("codice_ateco") @db.VarChar(20)
  email          String?     @db.VarChar(255)
  emailOperativa String?     @map("email_operativa") @db.VarChar(255)
  pec            String?     @db.VarChar(255)
  sitoWeb        String?     @map("sito_web") @db.VarChar(255)
  telefono       String?     @db.VarChar(40)
  telefono2      String?     @map("telefono_2") @db.VarChar(40)
  indirizzo      String?     @db.VarChar(255)
  noteOperative  String?     @map("note_operative")
  attivo         Boolean     @default(true)
  deletedAt      DateTime?   @map("deleted_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referenti            Referente[]
  preventivi           Preventivo[]
  mandati              Mandato[]
  scadenze             Scadenza[]
  comunicazioni        Comunicazione[]
  documenti            Documento[]
  circolariDestinatari CircolareDestinatario[]
  // [livello 2 — portale cliente, ADR-0046] utenti-portale di questa azienda.
  utentiPortale        User[]                  @relation("AziendaUtentiPortale")
  // Inviti onboarding clienti (token email → registrazione utente-portale).
  clienteInviti        ClienteInvito[]

  @@index([tenantId])
  @@index([tenantId, nome])
  @@map("aziende")
}

// Referente/contatto di un'azienda cliente (origine StudioDesk `aziende_referenti`,
// STOP-c3a ADR-0033). Satellite 1:N: FK azienda CASCADE (un referente non esiste
// senza la sua azienda). MVP 7 campi — `user_id` deferito (circolarità RFM, ADR-0031).
// Nessuna unicità naturale nel DDL → niente partial-unique.
model Referente {
  id        String         @id
  tenantId  String         @map("tenant_id")
  aziendaId String         @map("azienda_id")
  nome      String         @db.VarChar(150)
  ruolo     RuoloReferente @default(altro)
  email     String?        @db.VarChar(255)
  telefono  String?        @db.VarChar(40)
  note      String?        @db.VarChar(255)
  attivo    Boolean        @default(true)
  deletedAt DateTime?      @map("deleted_at")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  azienda       Azienda         @relation(fields: [aziendaId], references: [id], onDelete: Cascade)
  comunicazioni Comunicazione[]

  @@index([tenantId])
  @@index([aziendaId])
  @@map("referenti")
}

enum StatoPreventivo {
  bozza
  inviato
  accettato
  rifiutato
  convertito // accettato → convertito in mandato (ADR-0051, 1:1 con Mandato)
}

enum StatoMandato {
  in_corso
  sospeso
  concluso
  annullato
}

enum UnitaMisura {
  forfait
  ora
  mese
  anno
  documento
  dipendente
  pezzo
}

// Preventivo commerciale (testata), figlio di azienda (STOP-e1 ADR-0036).
// Origine StudioDesk 62_preventivi.sql, MVP: no catalogo/versioning/workflow.
// Totali ricalcolati server-side dalle voci in tx atomica (invariante
// totali ≡ Σ voci). Codice manuale, partial-unique soft-delete-aware (Pattern 42).
model Preventivo {
  id               String          @id
  tenantId         String          @map("tenant_id")
  aziendaId        String          @map("azienda_id")
  codice           String          @db.VarChar(32)
  oggetto          String          @db.VarChar(200)
  coverLetter      String?         @map("cover_letter")
  noteInterne      String?         @map("note_interne")
  stato            StatoPreventivo @default(bozza)
  validoFino       DateTime?       @map("valido_fino") @db.Date
  totaleImponibile Decimal         @default(0) @map("totale_imponibile") @db.Decimal(12, 2)
  totaleIva        Decimal         @default(0) @map("totale_iva") @db.Decimal(12, 2)
  totale           Decimal         @default(0) @db.Decimal(12, 2)
  deletedAt        DateTime?       @map("deleted_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  azienda Azienda          @relation(fields: [aziendaId], references: [id], onDelete: Cascade)
  voci    PreventivoVoce[]
  // 1:1 effettivo via partial-unique (preventivo_id WHERE deleted_at IS NULL) +
  // state-machine `convertito` (ADR-0051). A livello Prisma è una lista perché il
  // partial-unique non è esprimibile come @@unique. Il service legge il mandato
  // attivo con findFirst({ preventivoId, deletedAt: null }).
  mandati Mandato[]

  @@index([tenantId])
  @@index([aziendaId])
  @@index([tenantId, stato])
  @@map("preventivi")
}

// Riga di un preventivo (STOP-e1). Voce custom: snapshot nome/prezzo nella riga
// (no FK a catalogo in MVP). totaleRiga = qta * prezzoUnitario * (1 - sconto/100),
// ricalcolato dal service. Replace integrale in tx al salvataggio della testata.
model PreventivoVoce {
  id             String      @id
  tenantId       String      @map("tenant_id")
  preventivoId   String      @map("preventivo_id")
  nome           String      @db.VarChar(180)
  descrizione    String?
  unitaMisura    UnitaMisura @default(forfait) @map("unita_misura")
  quantita       Decimal     @default(1) @db.Decimal(10, 2)
  prezzoUnitario Decimal     @default(0) @map("prezzo_unitario") @db.Decimal(10, 2)
  scontoPct      Decimal     @default(0) @map("sconto_pct") @db.Decimal(5, 2)
  ivaAliquota    Decimal     @default(22) @map("iva_aliquota") @db.Decimal(5, 2)
  totaleRiga     Decimal     @default(0) @map("totale_riga") @db.Decimal(12, 2)
  ordine         Int         @default(0)
  note           String?     @db.VarChar(255)
  // Tracciabilità catalogo (ADR-0050): da quale voce di catalogo è stata
  // pre-compilata. NULLABLE + SetNull: lo snapshot denormalizzato sopra resta
  // sorgente di verità (i prezzi storici NON mutano se il catalogo cambia).
  servizioId     String?     @map("servizio_id")

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  preventivo  Preventivo        @relation(fields: [preventivoId], references: [id], onDelete: Cascade)
  servizio    ServizioCatalogo? @relation(fields: [servizioId], references: [id], onDelete: SetNull)
  prestazioni Prestazione[]

  @@index([tenantId])
  @@index([preventivoId, ordine])
  @@map("preventivi_voci")
}

// Visibilita' di una scadenza nel calendario fiscale (STOP-scad1, primo modulo
// del livello "operatore-studio" oltre anagrafica/preventivi/dashboard).
// `utente` predisposto: nessun campo userId su Scadenza nell'MVP (filtro
// per-utente non ancora cablato).
enum VisibilitaScadenza {
  tutti
  azienda
  utente

  @@map("visibilita_scadenza")
}

// Categorie scadenze (calendario fiscale). Pattern NUOVO: seed piattaforma
// (tenant_id NULL, immutabili) + custom per tenant. NON soft-delete. NON RLS:
// le righe piattaforma sono tenant_id NULL e una policy per-tenant ne romperebbe
// la lettura globale → le custom (tenant_id non-NULL) sono protette
// applicativamente nel service. Partial-unique nome-per-tenant SOLO sulle righe
// custom (WHERE tenant_id IS NOT NULL): le righe piattaforma non hanno vincolo
// di unicita' tra loro (design intenzionale). Prisma 6 non esprime i partial
// index nel DSL → niente @@unique qui, l'indice e' nella migration a mano.
model ScadenzaCategoria {
  id       String  @id
  tenantId String? @map("tenant_id")
  nome     String  @db.VarChar(100)
  colore   String  @default("#3b82f6") @db.VarChar(7)
  ordine   Int     @default(0)
  attivo   Boolean @default(true)

  tenant   Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scadenze Scadenza[]

  @@index([tenantId])
  @@map("scadenze_categorie")
}

// Scadenza del calendario fiscale (STOP-scad1). Tenant-level (NON nested sotto
// azienda come preventivi): `aziendaId` opzionale, obbligatorio solo se
// visibilita='azienda' (validato nel service). Soft-delete + RLS tenant-isolation
// come aziende. `codiceImport` predisposto (import esterni futuri), partial-unique
// per-tenant sulle righe attive.
model Scadenza {
  id           String             @id
  tenantId     String             @map("tenant_id")
  titolo       String             @db.VarChar(255)
  descrizione  String?
  dataScadenza DateTime           @map("data_scadenza") @db.Date
  categoriaId  String?            @map("categoria_id")
  visibilita   VisibilitaScadenza @default(tutti)
  aziendaId    String?            @map("azienda_id")
  attivo       Boolean            @default(true)
  codiceImport String?            @map("codice_import") @db.VarChar(80)
  deletedAt    DateTime?          @map("deleted_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoria ScadenzaCategoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  azienda   Azienda?           @relation(fields: [aziendaId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, dataScadenza])
  @@index([aziendaId])
  @@index([categoriaId])
  @@map("scadenze")
}

// =============================================================================
// Comunicazioni — thread 1:1 studio↔cliente (verticale accountant, ADR-0043).
// Modello dati riusato da StudioDesk PHP (docs/studiodesk/sql/01_studio_template.sql
// righe ~170-260), NON il codice. Differenze chiave dal PHP:
//   - ancoraggio thread ad azienda + referente (NON a uno user cliente: il
//     portale cliente è livello 2, non esiste pre-portale — DP-N1).
//   - tenantId DENORMALIZZATO su tutte e 3 le tabelle → RLS flat USING-only +
//     FORCE su ciascuna, nessuna subquery di nesting (DP-N2).
//   - codice per-tenant auto-generato via counter-row `com_counter` con
//     SELECT ... FOR UPDATE nella stessa tx dell'insert (DP-codice).
//   - snooze / auto-chiusura / multi-canale / whatsapp_inbound_log OMESSI
//     (backlog ADR-0043): origine nasce con solo `portale`, estendibile.
// =============================================================================

enum ComApertura {
  studio
  cliente

  @@map("com_apertura")
}

enum ComLato {
  studio
  cliente
  interno // nota tra operatori, MAI visibile in ottica cliente

  @@map("com_lato")
}

enum ComOrigine {
  portale // unico valore in F1; enum estendibile (telegram/email/wa = backlog ADR-0043)

  @@map("com_origine")
}

model Comunicazione {
  id                   String      @id
  tenantId             String      @map("tenant_id")
  codice               String      @db.VarChar(20) // COM-0001 per-tenant (partial-unique in SQL, no @@unique)
  aziendaId            String      @map("azienda_id")
  referenteId          String?     @map("referente_id") // referente cliente che ha aperto (lato cliente)
  apertaDa             ComApertura @map("aperta_da")
  operatoreAssegnatoId String?     @map("operatore_assegnato_id") // user interno; NULL = da prendere
  oggetto              String      @db.VarChar(255)
  urgente              Boolean     @default(false)
  chiusa               Boolean     @default(false)
  chiusaIl             DateTime?   @map("chiusa_il")
  deletedAt            DateTime?   @map("deleted_at")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  azienda            Azienda        @relation(fields: [aziendaId], references: [id], onDelete: Cascade)
  referente          Referente?     @relation(fields: [referenteId], references: [id], onDelete: SetNull)
  operatoreAssegnato User?          @relation("ComOperatore", fields: [operatoreAssegnatoId], references: [id], onDelete: SetNull)
  messaggi           ComMessaggio[]

  @@index([tenantId])
  @@index([tenantId, chiusa, operatoreAssegnatoId, urgente, updatedAt]) // inbox operatore
  @@index([tenantId, aziendaId, chiusa, updatedAt]) // thread per azienda
  @@map("comunicazioni")
}

model ComMessaggio {
  id              String     @id
  tenantId        String     @map("tenant_id") // denormalizzato (DP-N2: RLS flat)
  comunicazioneId String     @map("comunicazione_id")
  autoreUserId    String?    @map("autore_user_id") // user interno; NULL per lato cliente pre-portale
  lato            ComLato
  origine         ComOrigine @default(portale)
  testo           String
  lettoStudio     Boolean    @default(false) @map("letto_studio")
  lettoCliente    Boolean    @default(false) @map("letto_cliente")
  createdAt       DateTime   @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comunicazione Comunicazione @relation(fields: [comunicazioneId], references: [id], onDelete: Cascade)
  autore        User?         @relation("ComAutore", fields: [autoreUserId], references: [id], onDelete: SetNull)
  allegati      ComAllegato[]

  @@index([tenantId])
  @@index([comunicazioneId, createdAt])
  @@index([tenantId, lato, lettoStudio, lettoCliente])
  @@map("com_messaggi")
}

model ComAllegato {
  id          String   @id
  tenantId    String   @map("tenant_id") // denormalizzato (DP-N2: RLS flat)
  messaggioId String   @map("messaggio_id")
  nomeOrig    String   @map("nome_orig") @db.VarChar(255)
  percorso    String   @db.VarChar(500) // chiave storage opaca (StorageService), non path FS diretto
  mimeType    String   @default("application/octet-stream") @map("mime_type") @db.VarChar(100)
  dimensione  Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messaggio ComMessaggio @relation(fields: [messaggioId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([messaggioId])
  @@map("com_allegati")
}

// Counter per-tenant per la generazione del `codice` (COM-0001, COM-0002, ...).
// Incremento via SELECT ... FOR UPDATE nella stessa tx dell'insert della
// comunicazione (lock di riga seriale per-tenant → due aperture simultanee nello
// stesso tenant non collidono). RLS+FORCE flat come le altre tabelle.
model ComCounter {
  tenantId   String @id @map("tenant_id")
  lastNumber Int    @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("com_counter")
}

// =============================================================================
// Documenti — scambio documenti studio↔cliente (verticale accountant, ADR-0044).
// Modello dati riusato da StudioDesk PHP (docs/studiodesk/sql/05_documenti.sql),
// NON il codice. Scope MVP da product-interview 10/06 (NON dal BRIEF, che è muto
// sul modulo accountant). Distinto dagli allegati di comunicazione (com_allegati,
// legati al thread). File via StorageService (graduato in @gestionale/platform).
// Fuori MVP (backlog ADR-0044): letture/ricevute, user_state archivia/elimina,
// modelli con schema campi (fase 6C), password per-documento, scadenze+avvisi.
// =============================================================================

enum DirezioneDocumento {
  studio_cliente
  cliente_studio
  bidirezionale

  @@map("direzione_documento")
}

// Visibilità MVP: solo `tutti` | `azienda`. `utente` (targeting per-utente
// cliente) è nel backlog — richiede il portale cliente (livello 2) e una colonna
// user_id target. Vedi ADR-0044 (TD utente-enum forward).
enum VisibilitaDocumento {
  tutti
  azienda

  @@map("visibilita_documento")
}

// Catalogo tipi documento: platform (tenantId NULL, immutabili) + custom
// per-tenant. NIENTE RLS (le righe platform hanno tenant_id NULL): scoping
// applicativo `tenantId IS NULL OR tenantId = current` + partial-unique sulle
// custom (pattern ScadenzaCategoria, ADR-0039).
model DocumentoTipo {
  id                String              @id
  tenantId          String?             @map("tenant_id") // NULL = platform immutabile
  nome              String              @db.VarChar(100)
  direzione         DirezioneDocumento
  visibilitaDefault VisibilitaDocumento @default(tutti) @map("visibilita_default")
  ordine            Int                 @default(0)
  attivo            Boolean             @default(true)

  tenant    Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documenti Documento[]
  // partial-unique (tenant_id, nome) WHERE tenant_id IS NOT NULL → in SQL (Pattern 42)

  @@index([tenantId])
  @@map("documenti_tipi")
}

// Documenti reali. RLS+FORCE flat (tenant_id diretto). `storageKey` = chiave
// opaca dello StorageService (MAI path nudo); il file vive fuori dal docroot,
// download via API con check di visibilità applicativo.
model Documento {
  id            String              @id
  tenantId      String              @map("tenant_id")
  tipoId        String              @map("tipo_id")
  aziendaId     String              @map("azienda_id")
  nomeOriginale String              @map("nome_originale") @db.VarChar(255)
  storageKey    String              @map("storage_key") @db.VarChar(500)
  mimeType      String              @default("application/octet-stream") @map("mime_type") @db.VarChar(100)
  dimensione    Int                 @default(0)
  visibilita    VisibilitaDocumento @default(tutti)
  note          String?
  createdBy     String              @map("created_by") // user interno
  deletedAt     DateTime?           @map("deleted_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo    DocumentoTipo @relation(fields: [tipoId], references: [id], onDelete: Restrict)
  azienda Azienda       @relation(fields: [aziendaId], references: [id], onDelete: Cascade)
  autore  User          @relation("DocumentoCreatore", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, aziendaId, deletedAt])
  @@index([tipoId])
  @@map("documenti")
}

// =============================================================================
// Circolari — broadcast unidirezionale studio→clienti (verticale accountant, ADR-0045)
// =============================================================================
// MVP livello 1 (operatore studio): testata + destinatari + macchina di stato
// bozza→pubblicata→archiviata. `circolari_letture` e `richiede_conferma` DEFER
// al livello 2 (portale cliente). Email/AI/telegram/versioning/solleciti fuori
// scope (ADR-0045). tenantId denormalizzato sui destinatari → RLS flat (come
// comunicazioni DP-N2). Nessun `@default` su id: UUID v7 app-side via `id()`.

enum CircolareStato {
  bozza
  pubblicata
  archiviata

  @@map("circolare_stato")
}

enum DestinatarioTipo {
  tutti
  azienda
  utente // TD-circolari-utente-forward: enum-value pronto per livello 2, nessuna logica MVP

  @@map("destinatario_tipo")
}

model Circolare {
  id               String         @id
  tenantId         String         @map("tenant_id")
  titolo           String         @db.VarChar(200)
  oggettoEmail     String         @map("oggetto_email") @db.VarChar(200)
  bodyHtml         String         @map("body_html")
  stato            CircolareStato @default(bozza)
  priorita         Int            @default(0)
  // [livello 2 — portale cliente, ADR-0048] richiede presa-visione esplicita dal
  // cliente. Authoring lato studio (create/update); consumato dal lettore portale.
  richiedeConferma Boolean        @default(false) @map("richiede_conferma")
  pubblicataIl     DateTime?      @map("pubblicata_il")
  scadeIl          DateTime?      @map("scade_il")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  destinatari CircolareDestinatario[]
  letture     CircolareLettura[]

  @@index([tenantId])
  @@index([tenantId, stato, deletedAt])
  @@map("circolari")
}

model CircolareDestinatario {
  id          String           @id
  tenantId    String           @map("tenant_id") // denormalizzato (RLS flat, no nesting)
  circolareId String           @map("circolare_id")
  tipo        DestinatarioTipo
  aziendaId   String?          @map("azienda_id") // non-null solo se tipo = azienda (validato nel service)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  circolare Circolare @relation(fields: [circolareId], references: [id], onDelete: Cascade)
  azienda   Azienda?  @relation(fields: [aziendaId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([circolareId])
  @@index([tenantId, aziendaId])
  @@map("circolari_destinatari")
}

// [livello 2 — portale cliente, ADR-0048] Tracking lettura/conferma per utente.
// Una riga per (circolare, utente-cliente): `lettaAt` segnato all'apertura del
// dettaglio (markLetta on-open, idempotente via upsert); `confermataAt` valorizzato
// solo se la circolare `richiedeConferma` (POST :id/conferma). `tenantId`
// denormalizzato → RLS flat USING-only, identica alle altre tabelle del modulo.
model CircolareLettura {
  id           String    @id
  tenantId     String    @map("tenant_id") // denormalizzato (RLS flat, no nesting)
  circolareId  String    @map("circolare_id")
  userId       String    @map("user_id")
  lettaAt      DateTime  @default(now()) @map("letta_at")
  confermataAt DateTime? @map("confermata_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  circolare Circolare @relation(fields: [circolareId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circolareId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("circolari_letture")
}

// =============================================================================
// Catalogo servizi (ADR-0050, Onda 3 Task 1)
// =============================================================================
// Listino servizi dello studio commercialista, riusabile nei preventivi.
// Pattern platform/custom identico a ScadenzaCategoria/DocumentoTipo:
//   - tenantId NULLABLE: null = riga di piattaforma (catalogo standard condiviso,
//     seedato una volta), valorizzato = voce custom dello studio.
//   - NESSUNA RLS su questi due modelli (le righe platform hanno tenant_id NULL,
//     incompatibili con la policy tenant_isolation): scoping ESPLICITO nel
//     service via OR: [{ tenantId: null }, { tenantId }].
//   - Unicità via PARTIAL UNIQUE INDEX raw SQL (Prisma 6 non li esprime):
//     (tenant_id, nome) e (tenant_id, codice) WHERE tenant_id IS NOT NULL →
//     le righe custom sono uniche per-tenant, le platform non vincolate fra loro.
// =============================================================================

enum TipoRicorrenza {
  una_tantum
  mensile
  annuale
}

model ServizioCategoria {
  id          String   @id
  tenantId    String?  @map("tenant_id")
  nome        String
  descrizione String?
  colore      String   @default("#6366f1")
  ordine      Int      @default(0)
  attivo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  servizi ServizioCatalogo[]

  @@index([tenantId])
  @@map("servizi_categorie")
}

model ServizioCatalogo {
  id             String         @id
  tenantId       String?        @map("tenant_id")
  codice         String
  nome           String
  descrizione    String?
  categoriaId    String?        @map("categoria_id")
  unitaMisura    UnitaMisura    @default(forfait) @map("unita_misura")
  prezzoBase     Decimal        @default(0) @map("prezzo_base") @db.Decimal(10, 2)
  ivaAliquota    Decimal        @default(22) @map("iva_aliquota") @db.Decimal(5, 2)
  tipoRicorrenza TipoRicorrenza @default(una_tantum) @map("tipo_ricorrenza")
  attivo         Boolean        @default(true)
  ordine         Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  categoria      ServizioCategoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  preventivoVoci PreventivoVoce[]

  @@index([tenantId])
  @@index([categoriaId])
  @@map("servizi_catalogo")
}

// =============================================================================
// Mandati / Incarichi (ADR-0051, Onda 3 Task 2)
// =============================================================================
// La "lettera d'incarico" che nasce da un preventivo ACCETTATO (origine legacy
// rapporti_lavoro). Dato puro-tenant → RLS FORCE standard (pattern Preventivo).
// Relazione 1:1 col preventivo: alla creazione il preventivo passa a stato
// `convertito` (guard: solo da `accettato`) + partial-unique su preventivo_id
// (soft-delete-aware, Pattern 42). `importoConcordato` = snapshot preventivo.totale.
// codice RDL-<anno>-<NNNN> via counter per-tenant per-anno (RdlCounter, pattern
// ComCounter). Timesheet/prestazioni + hook fatturazione: DEFER Task 3/4.
// =============================================================================

model Mandato {
  id                String       @id
  tenantId          String       @map("tenant_id")
  preventivoId      String       @map("preventivo_id")
  aziendaId         String       @map("azienda_id")
  codice            String       @db.VarChar(32)
  stato             StatoMandato @default(in_corso)
  inizio            DateTime?    @db.Date
  finePrevista      DateTime?    @map("fine_prevista") @db.Date
  fineEffettiva     DateTime?    @map("fine_effettiva") @db.Date
  note              String?
  importoConcordato Decimal      @default(0) @map("importo_concordato") @db.Decimal(12, 2)
  deletedAt         DateTime?    @map("deleted_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  azienda     Azienda       @relation(fields: [aziendaId], references: [id], onDelete: Cascade)
  preventivo  Preventivo    @relation(fields: [preventivoId], references: [id], onDelete: Cascade)
  prestazioni Prestazione[]

  // NB: unicità 1:1 su preventivo_id via PARTIAL unique index raw SQL
  // (WHERE deleted_at IS NULL, Pattern 42) nella migration — non @@unique qui.
  @@index([tenantId])
  @@index([aziendaId])
  @@index([tenantId, stato])
  @@map("mandati")
}

// Counter per-tenant per-anno per il codice RDL-<anno>-<NNNN> (pattern ComCounter,
// ma chiave composta tenant+anno → progressivo che riparte ogni anno).
model RdlCounter {
  tenantId   String @map("tenant_id")
  anno       Int
  lastNumber Int    @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, anno])
  @@map("rdl_counter")
}

// =============================================================================
// Prestazioni / Timesheet (ADR-0053, Onda 3 Task 3)
// =============================================================================
// Ore svolte su un mandato (origine legacy rapporti_prestazioni). Dato puro-tenant
// → RLS FORCE standard (pattern Mandato). Si aggiungono SOLO a mandati in_corso
// (guard al create nel service). `importo` manuale nullable (nessun calcolo
// automatico: il tariffario è Task 3b/4). `userId` = autore (assegnato server-side).
// `voceId` opzionale → voce del preventivo del mandato (SetNull). Hook fatturazione
// (fatturato_at/fattura_id) DEFER Task 4 — non presenti.
// =============================================================================
model Prestazione {
  id          String    @id
  tenantId    String    @map("tenant_id")
  mandatoId   String    @map("mandato_id")
  voceId      String?   @map("voce_id")
  userId      String?   @map("user_id")
  data        DateTime  @db.Date
  ore         Decimal   @db.Decimal(5, 2)
  descrizione String    @db.VarChar(500)
  fatturabile Boolean   @default(true)
  importo     Decimal?  @db.Decimal(10, 2)
  note        String?
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mandato Mandato         @relation(fields: [mandatoId], references: [id], onDelete: Cascade)
  voce    PreventivoVoce? @relation(fields: [voceId], references: [id], onDelete: SetNull)
  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([mandatoId, data])
  @@map("prestazioni")
}

// =============================================================================
// Tariffario orario (ADR-0055, Onda 4 Task 3b): COSTO orario interno per ruolo
// (default) o utente (override). Alla create/update della prestazione risolve:
//   1) tariffa-utente (override) se presente; altrimenti
//   2) tariffa-ruolo: la PIU' ALTA tra i ruoli dell'utente (tie-break confermato);
//   3) nessuna → importo resta NULL (comportamento odierno invariato).
// Popola Prestazione.importo (= ore x tariffaOraria) → sblocca report margine.
// Scope esclusivo (roleId XOR userId) via CHECK + partial-unique soft-delete-aware
// in migration raw SQL (Prisma 6 non esprime CHECK/partial index nel DSL).
// =============================================================================
model TariffaOraria {
  id            String    @id
  tenantId      String    @map("tenant_id")
  roleId        String?   @map("role_id") // scope=ruolo (default) ⟺ user_id NULL
  userId        String?   @map("user_id") // scope=utente (override) ⟺ role_id NULL
  tariffaOraria Decimal   @map("tariffa_oraria") @db.Decimal(10, 2)
  attivo        Boolean   @default(true)
  note          String?
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role?  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([roleId])
  @@index([userId])
  @@map("tariffe_orarie")
}
