{
  "name": "@gestionale/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma data layer per il monorepo Gestionale: schema multi-tenant, migrations, client tipizzato condiviso.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:migrate:create-only": "dotenv -e ../../.env -- prisma migrate dev --create-only",
    "prisma:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:migrate:status": "dotenv -e ../../.env -- prisma migrate status",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "prisma:format": "prisma format",
    "smoke:soft-delete": "dotenv -e ../../.env -- tsx scripts/smoke-soft-delete.ts",
    "smoke:rls-e2e": "dotenv -e ../../.env -- tsx scripts/smoke-rls-e2e.ts",
    "smoke:rls-core": "dotenv -e ../../.env -- tsx scripts/smoke-rls-core.ts",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "dotenv-cli": "^11.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@prisma/client": "6",
    "argon2": "^0.44.0",
    "prisma": "6",
    "uuidv7": "^1.2.1"
  }
}
