{
  "name": "@gestionale/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma data layer per il monorepo Gestionale: schema multi-tenant, migrations, client tipizzato condiviso.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:migrate:create-only": "dotenv -e ../../.env -- prisma migrate dev --create-only",
    "prisma:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:migrate:status": "dotenv -e ../../.env -- prisma migrate status",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "prisma:format": "prisma format",
    "smoke:soft-delete": "dotenv -e ../../.env -- tsx scripts/smoke-soft-delete.ts",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "@prisma/client": "6",
    "prisma": "6",
    "uuidv7": "^1.2.1"
  }
}
