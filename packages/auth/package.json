{
  "name": "@gestionale/auth",
  "version": "0.0.0",
  "private": true,
  "description": "Core auth multi-tenant NestJS (auth, rbac, users, tenancy, tenant-context) come dual-package ESM+CJS. ADR-0027 §D5 passo 7.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.19",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "@types/passport-jwt": "^4.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@gestionale/db": "workspace:*",
    "@gestionale/platform": "workspace:*",
    "@gestionale/shared": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "argon2": "^0.44.0",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  }
}
