{
  "name": "gestionale",
  "version": "0.0.0",
  "private": true,
  "description": "Piattaforma SaaS modulare multi-tenant, AI-native ed estensibile per studi professionali.",
  "type": "module",
  "engines": {
    "node": ">=20.18.0 <21",
    "pnpm": ">=9.15.0 <10"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "smoke:accountant": "pnpm --filter @gestionale/accountant-web test:e2e:smoke",
    "smoke": "pnpm smoke:accountant",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "devdb:up": "docker compose -f docker-compose.devdb.yml up -d --wait",
    "devdb:down": "docker compose -f docker-compose.devdb.yml down",
    "devdb:migrate": "pnpm --filter @gestionale/db devdb:migrate",
    "devdb:seed": "pnpm --filter @gestionale/db devdb:seed",
    "devdb:generate": "pnpm --filter @gestionale/db prisma:generate",
    "devdb:setup": "pnpm devdb:up && pnpm devdb:generate && pnpm devdb:migrate && pnpm devdb:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@gestionale/eslint-config": "workspace:*",
    "@types/node": "^20.17.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
