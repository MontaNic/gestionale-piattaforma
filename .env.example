# =============================================================================
# .env.example — template variabili ambiente per docker-compose.dev.yml
# =============================================================================
# Copia in `.env` e sostituisci i valori. Il file `.env` NON va committato.
# Genera segreti robusti con:   openssl rand -base64 32
# -----------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-generate-with-openssl-rand-base64-32
POSTGRES_DB=gestionale

# --- Redis ---
# In DEV: nessuna password (network Docker bridge interna).
# In STAGING/PROD: definire REDIS_PASSWORD e aggiungere --requirepass al servizio in compose.
#REDIS_PASSWORD=changeme-generate-with-openssl-rand-base64-32

# Host/port di Redis consumati da apps/api (RedisService + ThrottlerModule).
# Container `gestionale_redis` espone 6379 sulla network bridge. L'API girando
# direttamente sull'host (ts-node-dev) parla via 127.0.0.1 grazie al port
# binding di docker-compose (vedi docker-compose.dev.yml). Quando l'API
# verra' containerizzata, override a `redis` (service name).
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Rate limiting (B1: @nestjs/throttler + Redis storage) ---
# 3 named throttlers. TTL in millisecondi, limit = richieste consentite per TTL.
#   - default      : fallback globale (tutti gli endpoint, applicato via APP_GUARD)
#   - auth-strict  : /auth/login + /auth/login-pin (opt-in via @Throttle decorator)
#   - tenant-create: POST /tenants (opt-in via @Throttle decorator)
# Tuning: override senza re-deploy quando avremo metriche reali F1+.
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=60
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=5
THROTTLE_TENANT_CREATE_TTL_MS=3600000
THROTTLE_TENANT_CREATE_LIMIT=3

# B2a sessione 9: per-tenant rate limit /auth/login-pin (ADR-0014).
# Tracker (tenantId, ip) custom in AppThrottlerGuard. Default 10 req/60s:
# PIN 4-6 cifre brute-forceable (10^4-10^6 keyspace), per-tenant limita
# blast radius. Coerente con anti-brute timing argon2.verify naturale.
THROTTLE_AUTH_PIN_TTL_MS=60000
THROTTLE_AUTH_PIN_LIMIT=10

# --- Account lockout (B1 sessione 8, ADR-0013) ---
# Sliding window Redis: dopo LOCKOUT_THRESHOLD attempt falliti entro
# LOCKOUT_WINDOW_MS, l'identificatore e' bloccato per LOCKOUT_DURATION_MS.
#   - /auth/login        : key = email (TD-H, futuro tenantId+email)
#   - /auth/login-pin    : key = (tenantId, deviceId) — D2b §8
# Retry-After header response = 900s FISSI (anti user-enumeration TD-J).
LOCKOUT_THRESHOLD=10
LOCKOUT_WINDOW_MS=900000
LOCKOUT_DURATION_MS=900000

# --- Email / SMTP (B2a sessione 9, ADR-0014) ---
# Dev: Mailpit catch-all container (docker-compose.dev.yml). SMTP locale +
# web UI http://127.0.0.1:8025 per ispezione email senza inviare a
# destinatari reali. Production: SMTP provider esterno (Postmark/SES/Resend
# — TD-Z ADR-0014).
# NB: scelto Mailpit (NON MailHog abbandonato 2020) — vedi discovery #22
# in ADR-0014. API REST endpoint: /api/v1/messages (NON v2 come MailHog).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Mailpit dev: nessun auth richiesto. Production: definire user/pass.
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@gestionale.local
# SMTP_SECURE=true se provider richiede TLS implicito (porta 465).
# Per STARTTLS opportunistico (porta 587 tipico), lascia false.
SMTP_SECURE=false

# --- Prisma / Database connection (D3b RLS Active) ---
# D3b ha introdotto un app role non-superuser `gestionale_app` (NOSUPERUSER,
# NOBYPASSRLS) per il runtime applicativo. Le migration runnano come
# `postgres` (superuser) via DIRECT_URL.
#
# Pattern dual-URL Prisma:
# - DATABASE_URL = connection runtime (app role, RLS enforced)
# - DIRECT_URL   = connection migration/admin (superuser)
#
# Schema Prisma: `directUrl = env("DIRECT_URL")` mappato a packages/db/prisma/schema.prisma.
# Vedi ADR-0009 sezioni "R9" e "D3b — Activation".
#
# APP_DB_PASSWORD: password raw del role gestionale_app.
# - Generala con: openssl rand -base64 32
# - Tienila SINCRONIZZATA con il PASSWORD del CREATE ROLE in DB (vedi sotto)
# - Postgres password con `=`, `+`, `/` DEVONO essere URL-encoded nella
#   connection string DATABASE_URL: `=` -> %3D, `+` -> %2B, `/` -> %2F.
#   Use: node -e "console.log(encodeURIComponent('<password>'))".
APP_DB_PASSWORD=changeme-generate-with-openssl-rand-base64-32

# DATABASE_URL: app role connection (runtime). Password URL-encoded.
# Esempio (sostituisci <APP_DB_PASSWORD_URL_ENCODED>):
DATABASE_URL=postgresql://gestionale_app:<APP_DB_PASSWORD_URL_ENCODED>@127.0.0.1:5432/gestionale?schema=public

# DIRECT_URL: superuser connection (migration + admin ops). Usa POSTGRES_PASSWORD sopra.
# IMPORTANTE: la password DEVE coincidere con POSTGRES_PASSWORD.
DIRECT_URL=postgresql://postgres:changeme-generate-with-openssl-rand-base64-32@127.0.0.1:5432/gestionale?schema=public

# --- API server (apps/api) ---
# Porta TCP del server NestJS. Default 3000 se non settata.
# Override locale: PORT=4000 pnpm --filter @gestionale/api dev
#PORT=3000

# --- CORS (E2 discovery F6) ---
# Origin del frontend autorizzato a chiamare l'API. Specific (no wildcard).
# Dev default: http://localhost:3001 (Next.js apps/web).
# Produzione: setta al domain reale (es. https://app.gestionale.example).
# Multi-origin (es. web + kds futuro): valutare array origin o regex pattern.
CORS_ORIGIN=http://localhost:3001

# --- JWT (apps/api auth module D2) ---
# Secret HS256 per firma JWT access (15min) + refresh (7d con rotation).
# Genera con: openssl rand -base64 48
# IMPORTANTE: rigenerare in ogni env (dev/staging/prod), MAI riusare il
# valore di dev in prod. In rotazione: tutti i token esistenti vengono
# invalidati immediatamente.
JWT_SECRET=changeme-generate-with-openssl-rand-base64-48
