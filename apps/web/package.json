{
  "name": "@gestionale/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js 15 App Router frontend per la piattaforma Gestionale. Consumer di @gestionale/db via dual package (exports.import → dist/index.mjs).",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:ci": "playwright test --project=chromium --reporter=html,github",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@gestionale/db": "workspace:*",
    "@gestionale/i18n": "workspace:*",
    "@gestionale/shared": "workspace:*",
    "@gestionale/ui": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "clsx": "^2.1",
    "lucide-react": "^0.460",
    "next": "^15.0.0",
    "next-intl": "4.12.0",
    "next-themes": "0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.75.0",
    "tailwind-merge": "^2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4",
    "tailwindcss-animate": "^1.0",
    "typescript": "^5"
  }
}
