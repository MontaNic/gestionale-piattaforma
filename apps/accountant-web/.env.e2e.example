# Credenziali E2E Playwright accountant-web (NON commitare valori reali).
# Copia in .env.e2e (gitignored) con le credenziali seed reali.
# Fonte password: packages/db/prisma/seed.ts (costanti deterministiche per-ruolo).
#
# Tre profili-ruolo, tutti sul tenant `studio-demo`:
#   - SUPERADMIN     → admin@studio.local
#   - COLLABORATORE  → collaboratore@studio.local
#   - CLIENTE        → cliente@studio-demo.local
#
# Target: lo smoke gira contro l'URL pubblico. Imposta anche:
#   PLAYWRIGHT_BASE_URL=https://studiodesk.cloud

E2E_SUPERADMIN_EMAIL=admin@studio.local
E2E_SUPERADMIN_PASSWORD=<replace-with-seed-password>

E2E_COLLABORATORE_EMAIL=collaboratore@studio.local
E2E_COLLABORATORE_PASSWORD=<replace-with-seed-password>

E2E_CLIENTE_EMAIL=cliente@studio-demo.local
E2E_CLIENTE_PASSWORD=<replace-with-seed-password>
