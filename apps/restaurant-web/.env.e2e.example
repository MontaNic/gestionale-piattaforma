# Credenziali E2E Playwright (NON commitare valori reali)
# Copia in .env.e2e (gitignored) con credenziali seed reali.
# Vedi: packages/db/prisma/seed.ts per credenziali tenant demo + acme.

# NB: lo smoke (playwright.smoke.config.ts) ha già come default l'URL pubblico
# https://food.studiodesk.cloud. NON impostare PLAYWRIGHT_BASE_URL qui: questo
# file è condiviso con playwright.config.ts (funzionale-locale, default
# localhost:3001) → lo redirigerebbe verso prod. Per override puntuale, passa
# PLAYWRIGHT_BASE_URL inline al comando.

E2E_DEMO_EMAIL=admin@demo.local
E2E_DEMO_PASSWORD=<replace-with-seed-password>

E2E_ACME_EMAIL=manager@acme.local
E2E_ACME_PASSWORD=<replace-with-seed-password>

# Utente non-superuser (ruolo Direzione, tavoli.gestisci) sul tenant demo —
# usato da mappa-drag-persist.spec.ts (FE-5). Seedato da seedDevDirezione.
E2E_DIREZIONE_EMAIL=direzione@demo.local
E2E_DIREZIONE_PASSWORD=<replace-with-seed-password>
