# Credenziali E2E Playwright (NON commitare valori reali)
# Copia in .env.e2e (gitignored) con credenziali seed reali.
# Vedi: packages/db/prisma/seed.ts per credenziali tenant demo + acme.

E2E_DEMO_EMAIL=admin@demo.local
