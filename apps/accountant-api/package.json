{
  "name": "@gestionale/accountant-api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API per il verticale commercialisti (StudioDesk). Walking skeleton core-only (boot + auth/login + me); dominio in macro-task successivi.",
  "scripts": {
    "dev": "dotenv -e ../../.env -v PORT=3002 -v CORS_ORIGIN=http://localhost:3003 -- ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "nest build",
    "start:prod": "dotenv -e ../../.env -- node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project=unit --passWithNoTests",
    "test:watch": "vitest --project=unit",
    "test:e2e": "vitest run --project=e2e",
    "test:e2e:watch": "vitest --project=e2e"
  },
  "dependencies": {
    "@gestionale/auth": "workspace:*",
    "@gestionale/db": "workspace:*",
    "@gestionale/platform": "workspace:*",
    "@gestionale/shared": "workspace:*",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.10.1",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.19",
    "@swc/core": "^1.15.33",
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "dotenv-cli": "^11.0.0",
    "pg": "^8.20.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.9",
    "uuidv7": "^1.2.1",
    "vitest": "^3.2.4"
  }
}
