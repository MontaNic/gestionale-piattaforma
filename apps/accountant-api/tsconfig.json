{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Override per NestJS: CommonJS module system (vedi ADR-0007).
    // Niente ESM perche' i decorator + ts-node-dev sono battle-tested su CJS;
    // packages/db pure CJS post-CC2 (vedi ADR-0007 "Tech debt accepted").
    "module": "commonjs",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // noEmit: true perche' lo sviluppo passa per ts-node-dev (compila in
    // memoria). Per `nest build` (produzione futura) creeremo un
    // tsconfig.build.json dedicato con outDir + rootDir + exclude di
    // node_modules workspace deps.
    "noEmit": true,
    // declaration:false override base. apps/accountant-api e' leaf consumer
    // non libreria pubblicata: niente .d.ts da emettere. Override evita TS2742
    // sui return type che terminano in tipi interni Prisma.
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "*.tsbuildinfo"]
}
